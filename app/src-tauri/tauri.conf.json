{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenBlaze",
  "version": "0.1.0",
  "identifier": "ai.createfun.tokenblaze",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "console",
        "title": "TokenBlaze Console",
        "width": 1080,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false,
        "visible": true
      },
      {
        "label": "flame",
        "title": "TokenBlaze Flame",
        "url": "flame.html",
        "width": 168,
        "height": 239,
        "minWidth": 100,
        "minHeight": 100,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "focusable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
